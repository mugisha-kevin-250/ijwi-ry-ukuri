{
  "name": "RADAR — Real news, real people",
  "short_name": "RADAR",
  "description": "Real news, real people, and stories shaping Rwanda, Africa and the world.",
  "id": "https://www.radartimes.2bd.net/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#1877F2",
  "lang": "en",
  "dir": "ltr",
  "categories": ["news", "magazines"],
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "All stories",
      "short_name": "Stories",
      "description": "Browse every published story.",
      "url": "/articles",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Categories",
      "short_name": "Categories",
      "description": "Open a category of news.",
      "url": "/categories",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Search",
      "short_name": "Search",
      "description": "Search the newsroom.",
      "url": "/search",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
