# =============================================================================
# Frontend environment variables (Vite).
#
# CRITICAL: Vite reads these at BUILD time and INLINES the values into the
# compiled JS. Changing a VITE_* value does nothing until you re-run
# `npm run build` (and redeploy). This is the #1 deployment gotcha.
#
# Which file Vite loads:
#   - `npm run dev`      -> .env.local / .env                (mode "development")
#   - `npm run build`    -> .env.production / .env.local / .env  (mode "production")
# Copy this example to `.env.production` for the deploy build and to
# `.env` (or `.env.local`) for local dev.
# =============================================================================

# --- Local development -------------------------------------------------------
# The Vite dev server proxies /api and /uploads to the backend on :5000
# (see vite.config.js), so a same-origin relative base also works, but the code
# default is the absolute localhost URL. Keep this if you run the backend locally.
VITE_API_URL=http://localhost:5000/api

# --- Production build (Firebase Hosting) -------------------------------------
# Firebase Hosting is a STATIC host: it has NO dev-server proxy, so the built
# app must call the backend by ABSOLUTE URL. Set this in `.env.production` to
# your Render backend's API base URL, then rebuild + redeploy:
#
# VITE_API_URL=https://REPLACE_WITH_YOUR_RENDER_SERVICE_URL.onrender.com/api
#
# Remember: uploaded images are served from the Render origin under /uploads/...
# (they are NOT proxied by Firebase) — see DEPLOYMENT.md "Known deploy blockers".

# --- Web Push ----------------------------------------------------------------
# Optional. The VAPID public key (backend VAPID_PUBLIC_KEY) inlined at build
# time. Leave it empty to have the app fetch the key from
# GET /api/push/public-key at runtime, which survives a key rotation without a
# new frontend build.
#
# VITE_VAPID_PUBLIC_KEY=
