# Production build (Firebase Hosting). Vite inlines this at BUILD time —
# after editing it you must re-run `npm run build` and redeploy.
# Verify the host matches your Render service once the blueprint has deployed.
VITE_API_URL=https://studentnews-backend.onrender.com/api

# Empty on purpose: the app reads the VAPID public key from
# GET /api/push/public-key at runtime, so rotating the pair needs no rebuild.
VITE_VAPID_PUBLIC_KEY=

# Paste the OAuth web client id to show the "Continue with Google" button.
# It must match GOOGLE_CLIENT_ID on the API, then rebuild + redeploy.
VITE_GOOGLE_CLIENT_ID=423361172120-8m17rtkmh91qc5b3r9o3qc3s5c2tvh9f.apps.googleusercontent.com
