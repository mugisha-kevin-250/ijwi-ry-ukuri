PORT=5000
MONGODB_URI=
JWT_SECRET=change_me_super_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
CLIENT_URL=http://localhost:3000
RATE_PER_1000_VIEWS=5000
MINIMUM_PAYOUT=10000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Web Push (VAPID). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The private key never leaves the env file; the public one is served to clients
# by GET /api/push/public-key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://ijwi-ry--ukuri.web.app
