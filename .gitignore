# Dependencies and builds
node_modules/
dist/
dist-ssr/
build/
*.tsbuildinfo

# Environment files — .env.render holds the live Atlas credential.
.env
.env.*
!.env.example
!.env.production

# Local uploads are committed so a fresh Render disk can be seeded from them;
# only the log/scratch files that can accumulate beside them are ignored.
backend/uploads/*.tmp
.DS_Store

# Logs and tooling output
*.log
logs/
.firebase/
firebase-debug.log
firebasesdk-debug.log

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scratch image generation output (unreferenced by the app)
vibe_images/
