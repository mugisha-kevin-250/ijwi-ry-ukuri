PORT=5000
MONGODB_URI=
# Required in production: the server refuses to boot on the development key.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_super_secret
CLIENT_URL=http://localhost:3000
RATE_PER_1000_VIEWS=5000
MINIMUM_PAYOUT=10000
# Web Push (VAPID). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The private key never leaves the env file; the public one is served to clients
# by GET /api/push/public-key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://ijwi-ry--ukuri.web.app
# Gemini writes the admin's story drafts. Get a key at https://aistudio.google.com/apikey
# and paste it into the server environment only - the browser never sees it, and
# without it the AI writer stays hidden in the admin portal.
# Optional Audius read-only API key for higher catalogue/stream rate limits.
# Obtain one at https://api.audius.co/plans; keep credentials on the backend only.
AUDIUS_API_KEY=
GEMINI_API_KEY=
# Any text model from GET /v1beta/models. The default is the cheapest fast one.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_MS=90000
# Google sign-in: the same public Client ID the frontend builds with. The token
# Google hands over is checked against this, so leaving it empty turns
# POST /api/auth/google into a 503 instead of accepting anyone.
GOOGLE_CLIENT_ID=
# Where the API is reachable from the outside. Uploaded image URLs are rewritten
# to the origin in the request, so this is only needed when a worker or crawler
# asks for absolute links.
PUBLIC_URL=
# Render's free plan has no disk, so uploads are kept in MongoDB and this folder
# is only a cache that every deploy wipes. Both default to backend/uploads.
UPLOAD_DIR=
SEED_UPLOADS_DIR=
# Atlas M0 gives the whole cluster 512MB; this caps the image collection so a
# full cluster cannot take every query down with it.
UPLOAD_STORE_LIMIT_MB=400
# Not read by any code yet: there is no mailer in this project, and a story
# correction or a payout notice is still an in-app notification. Kept here
# because email is the obvious next step, and setting them changes nothing
# until a mailer exists.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The newsletter mailer now DOES read the SMTP_* block above; that note
# predates it. These three finish the setup: MAIL_FROM_EMAIL is the address
# alerts are sent from (required, or every route reports email as not
# configured), MAIL_FROM_NAME is the display name, SMTP_SECURE=true is for an
# implicit-TLS port like 465 and stays unset for STARTTLS on 587.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
SMTP_SECURE=
# ---------------------------------------------------------------
# Reader languages, served by Google Cloud Translation (v2).
# ---------------------------------------------------------------
# A reader picks any language Google can translate into and the news, the
# section names and the labels of the site itself arrive in it. With no key the site
# is simply English everywhere and says so - nothing breaks and nothing is
# faked. The key is a secret: it goes in Render, never in this file and never
# in the repository.
# Required, and the only secret here. Cloud Console > APIs > Cloud
# Translation API > Credentials, restricted to this key.
GOOGLE_TRANSLATE_API_KEY=
# How long one Google call may take. A slow answer is abandoned and the
# reader gets the English original with a stated reason, not a spinning page.
TRANSLATE_TIMEOUT_MS=12000
# How much text goes into one Google call, in characters. Bigger values mean
# fewer calls; smaller ones mean a long story is cut into more pieces.
TRANSLATE_CHUNK_CHARS=4000
# The most text one request may translate. A story longer than this is still
# translated whole - the ceiling is per request, not per story.
TRANSLATE_MAX_CHARS=60000

# Cross-instance scheduler lease; MongoDB must be shared by all API instances.
SCHEDULER_LOCK_LEASE_MS=600000
